# Copy this file to .env and fill in your values. .env is git-ignored.

# Which Claude backend to use: "bedrock" (default) or "anthropic"
LLM_BACKEND=bedrock

# --- Amazon Bedrock credentials ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# --- Models (normally leave these unset) ---
# Coder default = paper's Sonnet 4.5. Judge default = Opus 4.5, because the
# paper's Opus 4 judge has reached end of life on Bedrock.
# Bare Anthropic IDs are mapped to Bedrock cross-region inference profiles,
# e.g. claude-sonnet-4-5-20250929 -> us.anthropic.claude-sonnet-4-5-20250929-v1:0
# You can also give a full Bedrock model ID / inference profile ID / ARN.
# CODER_MODEL=claude-sonnet-4-5-20250929
# JUDGE_MODEL=claude-opus-4-5-20251101
# BEDROCK_INFERENCE_PREFIX=us   # override the us./eu./apac. prefix ("" for none)

# --- Only needed with LLM_BACKEND=anthropic ---
# ANTHROPIC_API_KEY=
